#!/usr/bin/env bash
set -euo pipefail

ROOT="$1"
PALETTE="$2"

get() {
  jq -r --arg key "$1" '.[$key]' "$PALETTE"
}

BG="$(get background)"
SURFACE="$(get surface)"
FG="$(get foreground)"
PRIMARY="$(get primary)"
PRIMARY_CONTAINER="$(get primary_container)"
SECONDARY="$(get secondary)"
TERTIARY="$(get tertiary)"
ERROR="$(get error)"
OUTLINE="$(get outline)"
VARIANT="$(get surface_variant)"
ON_PRIMARY="$(get on_primary)"
ON_SURFACE_VARIANT="$(get on_surface_variant)"

# Mako: update its extensionless config directly.
sed -i \
  -e "s|^background-color=.*|background-color=$SURFACE|" \
  -e "s|^text-color=.*|text-color=$FG|" \
  -e "s|^border-color=.*|border-color=${OUTLINE}aa|" \
  "$ROOT/configs/mako/config"

# Btop: generate a complete custom theme outside the HM-managed config.
mkdir -p "$HOME/.config/btop/themes"

cat > "$HOME/.config/btop/themes/matugen.theme" <<BTOP_THEME
theme[main_bg]="$BG"
theme[main_fg]="$FG"
theme[title]="$PRIMARY"
theme[hi_fg]="$PRIMARY"
theme[selected_bg]="$PRIMARY_CONTAINER"
theme[selected_fg]="$ON_PRIMARY"
theme[inactive_fg]="$OUTLINE"
theme[graph_text]="$ON_SURFACE_VARIANT"
theme[meter_bg]="$VARIANT"
theme[proc_misc]="$TERTIARY"
theme[cpu_box]="$PRIMARY"
theme[mem_box]="$TERTIARY"
theme[net_box]="$SECONDARY"
theme[proc_box]="$PRIMARY_CONTAINER"
theme[div_line]="$OUTLINE"
theme[temp_start]="$TERTIARY"
theme[temp_mid]="$SECONDARY"
theme[temp_end]="$ERROR"
theme[cpu_start]="$PRIMARY"
theme[cpu_mid]="$SECONDARY"
theme[cpu_end]="$TERTIARY"
theme[free_start]="$TERTIARY"
theme[free_mid]="$SECONDARY"
theme[free_end]="$PRIMARY"
theme[cached_start]="$SECONDARY"
theme[cached_mid]="$PRIMARY"
theme[cached_end]="$TERTIARY"
theme[available_start]="$TERTIARY"
theme[available_mid]="$SECONDARY"
theme[available_end]="$PRIMARY"
theme[used_start]="$PRIMARY"
theme[used_mid]="$SECONDARY"
theme[used_end]="$ERROR"
theme[download_start]="$PRIMARY"
theme[download_mid]="$SECONDARY"
theme[download_end]="$TERTIARY"
theme[upload_start]="$TERTIARY"
theme[upload_mid]="$SECONDARY"
theme[upload_end]="$PRIMARY"
theme[process_start]="$TERTIARY"
theme[process_mid]="$SECONDARY"
theme[process_end]="$PRIMARY"
BTOP_THEME

# Make the repository's HM-managed btop config select the generated theme.
if grep -q '^color_theme = ' "$ROOT/configs/btop/btop.conf"; then
  sed -i 's|^color_theme = .*|color_theme = "matugen"|' \
    "$ROOT/configs/btop/btop.conf"
else
  printf '\ncolor_theme = "matugen"\n' >> "$ROOT/configs/btop/btop.conf"
fi

# Fastfetch: keep the module layout and add semantic Matugen colors.
python3 - "$ROOT/configs/fastfetch/config.jsonc" "$PALETTE" <<'PY'
import json
import sys
from pathlib import Path

config_path = Path(sys.argv[1])
palette = json.loads(Path(sys.argv[2]).read_text())
config = json.loads(config_path.read_text())

config["display"] = config.get("display", {})
config["display"]["color"] = {
    "keys": palette["primary"],
    "title": palette["secondary"],
    "separator": palette["outline"],
    "output": palette["foreground"],
}

semantic = {
    "memory": palette["tertiary"],
    "swap": palette["secondary"],
    "disk": palette["primary"],
    "packages": palette["secondary"],
    "localip": palette["tertiary"],
}

modules = []
for module in config.get("modules", []):
    if isinstance(module, str) and module in semantic:
        modules.append({
            "type": module,
            "keyColor": semantic[module],
        })
    else:
        modules.append(module)

config["modules"] = modules
config_path.write_text(json.dumps(config, indent=2) + "\n")
PY

echo "Mako, Btop and Fastfetch themes updated."
