#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
WALLPAPER="${1:?Usage: update-theme /path/to/wallpaper}"
PALETTE="$HOME/.config/quickshell/generated/colors.json"
BACKUPS="$HOME/.local/share/matugen/originals"

# Extract every source color dynamically and generate a palette for each.
mkdir -p "$(dirname "$PALETTE")"

PALETTE_DIR="$HOME/.local/share/matugen/palettes/current"
mkdir -p "$PALETTE_DIR"
rm -f "$PALETTE_DIR"/source-*.json

FOUND=0
LOG="$PALETTE_DIR/matugen.log"

for i in $(seq 0 127); do
    if nix run nixpkgs#matugen -- image "$WALLPAPER" \
        --config "$ROOT/configs/matugen/config.toml" \
        --source-color-index "$i" >"$LOG" 2>&1; then

        cp "$PALETTE" "$PALETTE_DIR/source-$i.json"
        FOUND=$((FOUND + 1))
    else
        if [ "$FOUND" -gt 0 ] && grep -qiE "invalid value.*source-color-index|source-color-index.*not in" "$LOG"; then
            break
        fi
        cat "$LOG" >&2
        exit 1
    fi
done

rm -f "$LOG"

if [ "$FOUND" -eq 0 ]; then
    echo "Matugen did not extract any source colors." >&2
    exit 1
fi

# Combine all extracted source palettes.
python3 - "$PALETTE_DIR" "$PALETTE" <<'MERGE'
import sys, json, colorsys
from pathlib import Path

directory, output = map(Path, sys.argv[1:])
files = sorted(
    directory.glob("source-*.json"),
    key=lambda p: int(p.stem.split("-")[-1])
)
sources = [json.loads(p.read_text()) for p in files]

def rgb(value):
    value = value.lstrip("#")
    return tuple(int(value[i:i+2], 16) for i in (0, 2, 4))

def hsv(value):
    return colorsys.rgb_to_hsv(*(v / 255 for v in rgb(value)))

# Start with the first generated palette.
merged = dict(sources[0])

# Use the least saturated extracted source for neutral surfaces.
neutral = min(sources, key=lambda p: hsv(p["source_color"])[1])

neutral_keys = [
    "background", "foreground", "surface", "on_surface",
    "surface_variant", "on_surface_variant", "surface_dim",
    "surface_bright", "surface_container_lowest",
    "surface_container_low", "surface_container",
    "surface_container_high", "surface_container_highest",
    "outline", "outline_variant", "inverse_surface",
    "inverse_on_surface", "shadow", "scrim"
]

for key in neutral_keys:
    if key in neutral:
        merged[key] = neutral[key]

# Sort chromatic source colors by their extracted hue.
# No wallpaper-specific colors or hue assignments are hardcoded.
chromatic = [
    p for p in sources
    if hsv(p["source_color"])[1] >= 0.18
]
chromatic.sort(key=lambda p: hsv(p["source_color"])[0])

# Populate Material's accent families from the dynamically extracted colors.
for family, source in zip(
    ("primary", "secondary", "tertiary"), chromatic
):
    for key, value in source.items():
        if "primary" in key:
            merged[key.replace("primary", family)] = value

# Retain every actual extracted source color for configuration recoloring.
merged["wallpaper_colors"] = [
    p["source_color"] for p in sources
]

output.write_text(json.dumps(merged, indent=2) + "\n")
print("Combined", len(sources), "wallpaper source colors:")
for color in merged["wallpaper_colors"]:
    print(" ", color)
MERGE

# Recolor configuration files from their original versions.
python3 - "$ROOT" "$PALETTE" "$BACKUPS" <<'PY'
import sys, re, json, colorsys, shutil
from pathlib import Path

root, palette_file, backup_root = map(Path, sys.argv[1:])
palette = json.loads(palette_file.read_text())
backup_root.mkdir(parents=True, exist_ok=True)

def choose(rgb):
    r, g, b = rgb
    h, saturation, v = colorsys.rgb_to_hsv(
        r / 255, g / 255, b / 255
    )
    light = colorsys.rgb_to_hls(
        r / 255, g / 255, b / 255
    )[1]

    # Keep neutral UI colors aligned with Matugen's surface palette.
    if saturation < 0.18:
        if light < 0.12:
            key = "background"
        elif light < 0.22:
            key = "surface_container_lowest"
        elif light < 0.32:
            key = "surface_container_low"
        elif light < 0.42:
            key = "surface"
        elif light < 0.52:
            key = "surface_container"
        elif light < 0.62:
            key = "surface_container_high"
        elif light < 0.72:
            key = "surface_container_highest"
        elif light < 0.84:
            key = "surface_variant"
        elif light < 0.92:
            key = "on_surface_variant"
        else:
            key = "foreground"

        return palette.get(key, palette["foreground"])

    # Find the closest extracted wallpaper hue.
    candidates = []

    for color in palette.get("wallpaper_colors", []):
        cr, cg, cb = [
            x / 255 for x in (
                int(color[1:3], 16),
                int(color[3:5], 16),
                int(color[5:7], 16)
            )
        ]
        ph, ps, pv = colorsys.rgb_to_hsv(cr, cg, cb)

        if ps < 0.18:
            continue

        hue_distance = abs(h - ph)
        hue_distance = min(hue_distance, 1 - hue_distance)

        score = (
            hue_distance * 2
            + abs(saturation - ps) * 0.35
            + abs(v - pv) * 0.10
        )
        candidates.append((score, ph, ps))

    if not candidates:
        return "#{:02x}{:02x}{:02x}".format(r, g, b)

    _, chosen_hue, chosen_saturation = min(candidates)

    # Preserve the original UI color's lightness for readable contrast.
    nr, ng, nb = colorsys.hls_to_rgb(
        chosen_hue,
        light,
        max(0.20, min(0.90, chosen_saturation))
    )

    return "#{:02x}{:02x}{:02x}".format(
        round(nr * 255),
        round(ng * 255),
        round(nb * 255)
    )

def recolor_hex(match):
    value = match.group(1)
    if len(value) == 3:
        rgb = tuple(int(c * 2, 16) for c in value)
        return choose(rgb)

    if len(value) == 6:
        rgb = tuple(int(value[i:i+2], 16) for i in (0, 2, 4))
        return choose(rgb)

    # QML/CSS-style eight digit colors: preserve leading alpha.
    alpha = value[:2]
    if alpha == "00":
        return "#" + value
    rgb = tuple(int(value[i:i+2], 16) for i in (2, 4, 6))
    return "#" + alpha + choose(rgb)[1:]

def recolor_rgba_hex(match):
    value = match.group(1)
    rgb = tuple(int(value[i:i+2], 16) for i in (0, 2, 4))
    return "rgba(" + choose(rgb)[1:] + value[6:]

def recolor_integer(match, rel):
    value = match.group(1)
    if "mango" in str(rel).lower():
        rgb = tuple(int(value[i:i+2], 16) for i in (0, 2, 4))
        return "0x" + choose(rgb)[1:] + value[6:]
    alpha = value[:2]
    rgb = tuple(int(value[i:i+2], 16) for i in (2, 4, 6))
    return "0x" + alpha + choose(rgb)[1:]

channel = r"(\d+(?:\.\d+)?(?:\s*/\s*255)?)"
rgba_pattern = re.compile(
    r"((?:Qt\.)?rgba)\(\s*" + channel + r"\s*,\s*" +
    channel + r"\s*,\s*" + channel + r"\s*,\s*([0-9.]+%?)\s*\)",
    re.I
)

def recolor_rgba(match):
    fn = match.group(1)
    raw = match.groups()[1:4]
    alpha = match.group(5)

    values = []
    normalized = True
    for item in raw:
        item = item.strip()
        if "/255" in item:
            values.append(round(float(item.split("/")[0]) / 255 * 255))
        elif float(item) <= 1:
            values.append(round(float(item) * 255))
        else:
            normalized = False
            values.append(round(float(item)))

    new = choose(tuple(max(0, min(255, x)) for x in values))

    if fn.lower().startswith("qt.") or normalized:
        channels = [f"{int(new[i:i+2],16)/255:.4f}" for i in (1,3,5)]
    else:
        channels = [str(int(new[i:i+2],16)) for i in (1,3,5)]

    return f"{fn}({', '.join(channels)}, {alpha})"

hex_pattern = re.compile(r"#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})(?![0-9a-fA-F])")
rgba_hex_pattern = re.compile(r"\brgba\(\s*([0-9a-fA-F]{8})\s*\)", re.I)
integer_pattern = re.compile(r"\b0x([0-9a-fA-F]{8})\b")
rgb_hex_pattern = re.compile(r"\brgb\(\s*([0-9a-fA-F]{6})\s*\)", re.I)

extensions = {
    ".qml", ".js", ".lua", ".conf", ".config", ".rasi",
    ".json", ".jsonc", ".toml", ".py", ".nix", ".sh",
    ".css", ".scss", ".ini", ".txt"
}
roots = ["configs", "home", "hosts", "profiles", "modules"]
changed = 0

for directory in roots:
    base = root / directory
    if not base.exists():
        continue

    for path in base.rglob("*"):
        if not path.is_file() or path.suffix.lower() not in extensions:
            continue
        if "matugen" in path.parts or ".matugen-work" in path.parts:
            continue
        if path.stat().st_size > 2_000_000:
            continue

        try:
            original = path.read_text()
        except (UnicodeDecodeError, OSError):
            continue

        if not re.search(
            r"#[0-9a-fA-F]{3,8}\b|rgba?\(|0x[0-9a-fA-F]{8}",
            original
        ):
            continue

        rel = path.relative_to(root)
        backup = backup_root / rel
        backup.parent.mkdir(parents=True, exist_ok=True)

        # Preserve the pre-Matugen version on the first run.
        if not backup.exists():
            shutil.copy2(path, backup)

        source = backup.read_text()

        # Apply format-specific transformations.
        source = rgba_hex_pattern.sub(recolor_rgba_hex, source)
        source = integer_pattern.sub(
            lambda m: recolor_integer(m, rel), source
        )
        source = rgba_pattern.sub(recolor_rgba, source)
        source = rgb_hex_pattern.sub(
            lambda m: "rgb(" + choose(tuple(
                int(m.group(1)[i:i+2], 16) for i in (0, 2, 4)
            ))[1:] + ")", source
        )
        source = hex_pattern.sub(recolor_hex, source)

        if source != path.read_text():
            path.write_text(source)
            changed += 1
            print("Themed:", rel)

print(f"\nMatugen updated {changed} configuration files.")
print("Original configurations backed up to:", backup_root)
PY

"$ROOT/scripts/update-theme-extras" "$ROOT" "$PALETTE"
