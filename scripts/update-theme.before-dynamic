#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
WALLPAPER="${1:?Usage: update-theme /path/to/wallpaper}"
PALETTE="$HOME/.config/quickshell/generated/colors.json"
BACKUPS="$HOME/.local/share/matugen/originals"

# Generate the wallpaper palette.
mkdir -p "$(dirname "$PALETTE")"

nix run nixpkgs#matugen -- image "$WALLPAPER" \
  --config "$ROOT/configs/matugen/config.toml" \
  --source-color-index 0

# Recolor configuration files from their original versions.
python3 - "$ROOT" "$PALETTE" "$BACKUPS" <<'PY'
import sys, re, json, colorsys, shutil
from pathlib import Path

root, palette_file, backup_root = map(Path, sys.argv[1:])
palette = json.loads(palette_file.read_text())
backup_root.mkdir(parents=True, exist_ok=True)

def choose(rgb):
    r, g, b = [x / 255 for x in rgb]
    h, saturation, v = colorsys.rgb_to_hsv(r, g, b)
    light = colorsys.rgb_to_hls(r, g, b)[1]

    if saturation < 0.18:
        if light < 0.12:
            key = "background"
        elif light < 0.22:
            key = "surface_container_lowest"
        elif light < 0.32:
            key = "surface_container_low"
        elif light < 0.42:
            key = "surface"
        elif light < 0.52:
            key = "surface_container"
        elif light < 0.62:
            key = "surface_container_high"
        elif light < 0.72:
            key = "surface_container_highest"
        elif light < 0.84:
            key = "surface_variant"
        elif light < 0.92:
            key = "on_surface_variant"
        else:
            key = "foreground"
        return palette.get(key, palette["foreground"])

    hue = h * 360

    if hue < 15 or hue >= 345:
        family = "error"
    elif hue < 70:
        family = "secondary"
    elif hue < 165:
        family = "tertiary"
    elif hue < 255:
        family = "primary"
    elif hue < 310:
        family = "tertiary"
    else:
        family = "secondary"

    if family == "error":
        if light < 0.30:
            key = "error_container"
        elif light < 0.82:
            key = "error"
        else:
            key = "on_error_container"
    elif light < 0.25:
        key = family + "_container"
    elif light < 0.42:
        key = family + "_fixed_dim"
    elif light < 0.70:
        key = family
    elif light < 0.86:
        key = family + "_fixed"
    else:
        key = "on_" + family + "_container"

    return palette.get(key, palette.get(family, palette["foreground"]))

def recolor_hex(match):
    value = match.group(1)
    if len(value) == 3:
        rgb = tuple(int(c * 2, 16) for c in value)
        return choose(rgb)

    if len(value) == 6:
        rgb = tuple(int(value[i:i+2], 16) for i in (0, 2, 4))
        return choose(rgb)

    # QML/CSS-style eight digit colors: preserve leading alpha.
    alpha = value[:2]
    if alpha == "00":
        return "#" + value
    rgb = tuple(int(value[i:i+2], 16) for i in (2, 4, 6))
    return "#" + alpha + choose(rgb)[1:]

def recolor_rgba_hex(match):
    value = match.group(1)
    rgb = tuple(int(value[i:i+2], 16) for i in (0, 2, 4))
    return "rgba(" + choose(rgb)[1:] + value[6:]

def recolor_integer(match, rel):
    value = match.group(1)
    if "mango" in str(rel).lower():
        rgb = tuple(int(value[i:i+2], 16) for i in (0, 2, 4))
        return "0x" + choose(rgb)[1:] + value[6:]
    alpha = value[:2]
    rgb = tuple(int(value[i:i+2], 16) for i in (2, 4, 6))
    return "0x" + alpha + choose(rgb)[1:]

channel = r"(\d+(?:\.\d+)?(?:\s*/\s*255)?)"
rgba_pattern = re.compile(
    r"((?:Qt\.)?rgba)\(\s*" + channel + r"\s*,\s*" +
    channel + r"\s*,\s*" + channel + r"\s*,\s*([0-9.]+%?)\s*\)",
    re.I
)

def recolor_rgba(match):
    fn = match.group(1)
    raw = match.groups()[1:4]
    alpha = match.group(5)

    values = []
    normalized = True
    for item in raw:
        item = item.strip()
        if "/255" in item:
            values.append(round(float(item.split("/")[0]) / 255 * 255))
        elif float(item) <= 1:
            values.append(round(float(item) * 255))
        else:
            normalized = False
            values.append(round(float(item)))

    new = choose(tuple(max(0, min(255, x)) for x in values))

    if fn.lower().startswith("qt.") or normalized:
        channels = [f"{int(new[i:i+2],16)/255:.4f}" for i in (1,3,5)]
    else:
        channels = [str(int(new[i:i+2],16)) for i in (1,3,5)]

    return f"{fn}({', '.join(channels)}, {alpha})"

hex_pattern = re.compile(r"#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})(?![0-9a-fA-F])")
rgba_hex_pattern = re.compile(r"\brgba\(\s*([0-9a-fA-F]{8})\s*\)", re.I)
integer_pattern = re.compile(r"\b0x([0-9a-fA-F]{8})\b")
rgb_hex_pattern = re.compile(r"\brgb\(\s*([0-9a-fA-F]{6})\s*\)", re.I)

extensions = {
    ".qml", ".js", ".lua", ".conf", ".config", ".rasi",
    ".json", ".jsonc", ".toml", ".py", ".nix", ".sh",
    ".css", ".scss", ".ini", ".txt"
}
roots = ["configs", "home", "hosts", "profiles", "modules"]
changed = 0

for directory in roots:
    base = root / directory
    if not base.exists():
        continue

    for path in base.rglob("*"):
        if not path.is_file() or path.suffix.lower() not in extensions:
            continue
        if "matugen" in path.parts or ".matugen-work" in path.parts:
            continue
        if path.stat().st_size > 2_000_000:
            continue

        try:
            original = path.read_text()
        except (UnicodeDecodeError, OSError):
            continue

        if not re.search(
            r"#[0-9a-fA-F]{3,8}\b|rgba?\(|0x[0-9a-fA-F]{8}",
            original
        ):
            continue

        rel = path.relative_to(root)
        backup = backup_root / rel
        backup.parent.mkdir(parents=True, exist_ok=True)

        # Preserve the pre-Matugen version on the first run.
        if not backup.exists():
            shutil.copy2(path, backup)

        source = backup.read_text()

        # Apply format-specific transformations.
        source = rgba_hex_pattern.sub(recolor_rgba_hex, source)
        source = integer_pattern.sub(
            lambda m: recolor_integer(m, rel), source
        )
        source = rgba_pattern.sub(recolor_rgba, source)
        source = rgb_hex_pattern.sub(
            lambda m: "rgb(" + choose(tuple(
                int(m.group(1)[i:i+2], 16) for i in (0, 2, 4)
            ))[1:] + ")", source
        )
        source = hex_pattern.sub(recolor_hex, source)

        if source != path.read_text():
            path.write_text(source)
            changed += 1
            print("Themed:", rel)

print(f"\nMatugen updated {changed} configuration files.")
print("Original configurations backed up to:", backup_root)
PY

"$ROOT/scripts/update-theme-extras" "$ROOT" "$PALETTE"
