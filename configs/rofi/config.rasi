configuration {
    modi: "drun";
    show-icons: true;
    drun-display-format: "{name}";
    display-drun: "APPS // PERSONNEL SYSTEMS";
}

* {
    bg:              rgba(21, 27, 22, 94%);
    fg:              #D5DEC8;
    selected-bg:     rgba(57, 72, 47, 92%);
    selected-fg:     #E5EBD9;

    border-gray:     #46563C;
    muted-gray:      #849078;
    unsc-green:      #9BAF75;
    offwhite:        #E5EBD9;
    amber:           #E9AD4C;

    background-color: @bg;
    text-color: @fg;

    normal-background: transparent;
    normal-foreground: @fg;

    alternate-normal-background: transparent;
    alternate-normal-foreground: @fg;

    selected-normal-background: @selected-bg;
    selected-normal-foreground: @selected-fg;

    selected-active-background: @selected-bg;
    selected-active-foreground: @selected-fg;

    selected-urgent-background: @selected-bg;
    selected-urgent-foreground: @selected-fg;
}

window {
    background-color: @bg;
    width: 600px;
    border: 2px;
    border-color: @border-gray;
    border-radius: 3px;
    padding: 18px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 14px;
    background-color: transparent;
}

inputbar {
    children: [ prompt, entry ];
    spacing: 10px;
    background-color: transparent;
    padding: 4px;
}

prompt {
    text-color: @unsc-green;
}

entry {
    text-color: @fg;
    placeholder: "SEARCH PERSONNEL / APPLICATIONS...";
    placeholder-color: @muted-gray;
}

listview {
    lines: 8;
    spacing: 3px;
    scrollbar: false;
    background-color: transparent;
}

element {
    padding: 8px;
    border-radius: 2px;
    background-color: transparent;
    text-color: @fg;
}

element normal {
    background-color: transparent;
    text-color: @fg;
}

element alternate {
    background-color: transparent;
    text-color: @fg;
}

element selected {
    background-color: @selected-bg;
    text-color: @selected-fg;
}

element-icon {
    size: 32px;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}
