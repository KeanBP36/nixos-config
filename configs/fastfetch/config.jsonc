{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    {
      "type": "packages",
      "keyColor": "#eca78a"
    },
    "shell",
    "separator",
    {
      "type": "memory",
      "keyColor": "#4c444c"
    },
    {
      "type": "swap",
      "keyColor": "#eca78a"
    },
    {
      "type": "disk",
      "keyColor": "#e78f69"
    },
    {
      "type": "localip",
      "keyColor": "#4c444c"
    },
    "separator",
    "break",
    "colors"
  ],
  "display": {
    "color": {
      "keys": "#ffb599",
      "title": "#fab1d9",
      "separator": "#988e97",
      "output": "#eae0e7"
    }
  }
}
